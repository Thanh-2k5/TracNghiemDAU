# ==========================================
# CẤU HÌNH MÔI TRƯỜNG - TRẮC NGHIỆM DAU
# ==========================================
APP_NAME="Hệ Thống Thi Trắc Nghiệm DAU"
APP_ENV=development
DEBUG=True
SQL_ECHO=False

# --- Cấu hình REST API Server (FastAPI) ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Cấu hình Real-time Socket Server (TCP / WebSocket) ---
SOCKET_HOST=0.0.0.0
SOCKET_PORT=9000
SOCKET_AUTO_START=True
HEARTBEAT_INTERVAL=10
HEARTBEAT_TIMEOUT=30
SESSION_ALIVE_SECONDS=90

# --- Cấu hình Cơ sở dữ liệu (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tracnghiem_dau

# --- Cấu hình Bảo mật & JWT ---
SECRET_KEY=change_this_to_a_secure_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_PASSWORD=Dau@123456
